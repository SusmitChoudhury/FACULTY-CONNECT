# FACULTY CONNECT ENVIRONMENT CONFIGURATION
PORT=5000
SECRET_KEY=faculty-connect-int335-lpu-secret-key-2026

# Database: Default SQLite for zero-config local run, or MySQL connection string
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/faculty_connect
